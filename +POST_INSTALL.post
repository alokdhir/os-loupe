#!/bin/sh

# the user Loupe runs as, and its data (reports use them even with the service off)
/usr/local/opnsense/scripts/loupe/setup_user.sh

# what only reports use has a file of its own
configctl template reload OPNsense/LoupeReports >/dev/null 2>&1
chmod 600 /usr/local/etc/loupe-reports.json 2>/dev/null

# an upgrade leaves the old loupd running: restart it with the new code (only if it is enabled)
if service loupe enabled; then
	service loupe restart
fi
