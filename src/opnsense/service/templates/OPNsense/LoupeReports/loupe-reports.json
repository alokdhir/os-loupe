{
    "switch_map": {
        "switches": [
{% if helpers.exists('OPNsense.Loupe.switches.switch') %}
{%   for sw in helpers.toList('OPNsense.Loupe.switches.switch') %}
            {"id": {{ sw['@uuid'] | tojson }}, "name": {{ sw.name | default('') | tojson }}, "address": {{ sw.address | tojson }}, "community": {{ sw.community | default('public') | tojson }}, "enabled": {{ 'false' if sw.enabled == '0' else 'true' }}}{{ "," if not loop.last }}
{%   endfor %}
{% endif %}
        ]
    },
    "devices": {
{% if helpers.exists('OPNsense.Loupe.devices.device') %}
{%   for dev in helpers.toList('OPNsense.Loupe.devices.device') %}
        {{ dev.mac | lower | replace('-', ':') | tojson }}: {"name": {{ dev.name | default('') | tojson }}, "type": {{ dev.type | default('') | tojson }}, "icon": {{ dev.icon | default('') | tojson }}}{{ "," if not loop.last }}
{%   endfor %}
{% endif %}
    }
}
