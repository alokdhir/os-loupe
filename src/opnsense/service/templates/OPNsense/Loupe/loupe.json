{
    "interfaces": [{% if not helpers.empty('OPNsense.Loupe.general.interfaces') %}{%
        for intf in OPNsense.Loupe.general.interfaces.split(',') %}{{ helpers.physical_interface(intf) | tojson }}{{ "," if not loop.last }}{% endfor %}{% endif %}],
    "networks": [{% if not helpers.empty('OPNsense.Loupe.general.interfaces') %}{%
        for intf in OPNsense.Loupe.general.interfaces.split(',') %}
        {"id": {{ intf | tojson }}, "device": {{ helpers.physical_interface(intf) | tojson }}, "name": {{ (helpers.getNodeByTag('interfaces.'+intf+'.descr') or intf | upper) | tojson }}}{{ "," if not loop.last }}{% endfor %}{% endif %}
    ],
    "retention": {
        "days_5m": {{ helpers.getNodeByTag('OPNsense.Loupe.general.retention_5m') or '30' }},
        "days_1h": {{ helpers.getNodeByTag('OPNsense.Loupe.general.retention_1h') or '365' }},
        "days_lookups": {{ helpers.getNodeByTag('OPNsense.Loupe.general.retention_lookups') or '30' }}
    },
    "services": [
{% if helpers.exists('OPNsense.Loupe.services.service') %}
{%   for svc in helpers.toList('OPNsense.Loupe.services.service') %}
        {"kind": {{ svc.kind | default('') | tojson }}, "pattern": {{ svc.suffix | tojson }}, "name": {{ svc.name | tojson }}}{{ "," if not loop.last }}
{%   endfor %}
{% endif %}
    ],
    "rules": [
{% if helpers.exists('OPNsense.Loupe.rules.rule') %}
{%   for rule in helpers.toList('OPNsense.Loupe.rules.rule') %}
        {"when": { {{ rule.field | tojson }}: {{ rule.pattern | tojson }} }, "type": {{ rule.type | tojson }}, "icon": {{ rule.icon | default('') | tojson }}}{{ "," if not loop.last }}
{%   endfor %}
{% endif %}
    ],
    "devices": {
{% if helpers.exists('OPNsense.Loupe.devices.device') %}
{%   for dev in helpers.toList('OPNsense.Loupe.devices.device') %}
        {{ dev.mac | lower | replace('-', ':') | tojson }}: {"name": {{ dev.name | default('') | tojson }}, "type": {{ dev.type | default('') | tojson }}, "icon": {{ dev.icon | default('') | tojson }}}{{ "," if not loop.last }}
{%   endfor %}
{% endif %}
    }
}
