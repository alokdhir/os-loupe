<form>
    <field>
        <id>device.mac</id>
        <label>MAC address</label>
        <type>text</type>
        <grid_view>
            <formatter>copy</formatter>
        </grid_view>
    </field>
    <field>
        <id>device.name</id>
        <label>Name</label>
        <type>text</type>
        <grid_view>
            <formatter>copy</formatter>
        </grid_view>
    </field>
    <field>
        <id>device.type</id>
        <label>Type</label>
        <type>text</type>
        <grid_view>
            <formatter>devtype</formatter>
        </grid_view>
        <help>Overrides the detected device type. Leave both Name and Type empty to go back to what Loupe detects.</help>
    </field>
    <field>
        <id>device.icon</id>
        <label>Icon</label>
        <type>dropdown</type>
        <grid_view>
            <visible>false</visible>
        </grid_view>
        <help>Shown next to the type. Automatic uses the icon of a built-in type with the same name.</help>
    </field>
</form>
