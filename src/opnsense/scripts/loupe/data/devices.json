{
 "_comment": [
  "Device identification rules for Loupe. See README 'Device rules'.",
  "A rule matches when every condition in 'when' (or every entry of 'all') matches; a list value means any of.",
  "Fields: mac_prefix, mdns_model (regex), hostname (regex), mdns_service (exact), dhcp_vendor (regex),",
  "dhcp_params (prefix of the request list), talks_to (domain suffix), vendor (whole word), private_mac (bool).",
  "Tiers run in a fixed order (strongest evidence first, see TIERS in lib/devid.py); a rule's tier defaults to its first field.",
  "'example' is synthetic evidence that must classify as this rule's type (checked by the tests).",
  "Distro rules (Ubuntu, Debian...) match the update servers a machine checks; containers can blur them."
 ],
 "rules": [
  {"when": {"mac_prefix": "52:54:00"}, "type": "Virtual machine", "vendor": "QEMU/KVM", "example": {"mac": "52:54:00:00:00:01"}},
  {"when": {"mdns_model": "^AppleTV"}, "type": "Apple TV", "example": {"info": {"mdns_models": ["model=AppleTV14,1"]}}},
  {"when": {"mdns_model": "^AudioAccessory"}, "type": "HomePod", "example": {"info": {"mdns_models": ["model=AudioAccessory5,1"]}}},
  {"when": {"mdns_model": "^(MacBook|Macmini|MacPro|iMac|Mac\\d|MacStudio)"}, "type": "Mac", "example": {"info": {"mdns_models": ["model=Mac14,14"]}}},
  {"when": {"mdns_model": "^iPhone"}, "type": "iPhone", "example": {"info": {"mdns_models": ["model=iPhone15,2"]}}},
  {"when": {"mdns_model": "^iPad"}, "type": "iPad", "example": {"info": {"mdns_models": ["model=iPad13,1"]}}},
  {"when": {"mdns_model": "^Watch"}, "type": "Apple Watch", "example": {"info": {"mdns_models": ["model=Watch6,1"]}}},
  {"when": {"mdns_model": "Chromecast|Google TV|Google Nest|Nest (Hub|Mini|Audio)|Google Home"}, "type": "Google Cast device", "example": {"info": {"mdns_models": ["model=Chromecast Ultra"]}}},
  {"when": {"mdns_model": "(?i)sonos"}, "type": "Sonos speaker", "example": {"info": {"mdns_models": ["model=Sonos One"]}}},
  {"when": {"mdns_model": "(?i)bravia|smart ?tv|^(LG|Samsung|Vizio|TCL|Hisense)"}, "type": "TV", "example": {"info": {"mdns_models": ["model=BRAVIA 4K VH22"]}}},
  {"when": {"mdns_model": "(?i)roku"}, "type": "Roku", "example": {"info": {"mdns_models": ["model=Roku Ultra"]}}},
  {"when": {"mdns_model": "(?i)^(usb_mdl|ty)=|laserjet|officejet|deskjet|envy|pixma|ecotank|brother|epson"}, "type": "Printer", "example": {"info": {"mdns_models": ["model=HP Color LaserJet MFP M476dw"]}}},
  {"when": {"hostname": "(?i)^kvm-[0-9a-f]{4}$"}, "type": "NanoKVM", "example": {"hostname": "kvm-0a1b"}},
  {"when": {"hostname": "(?i)^pikvm\\b"}, "type": "PiKVM", "example": {"hostname": "pikvm"}},
  {"when": {"hostname": "(?i)iphone"}, "type": "iPhone", "example": {"hostname": "Kids-iPhone"}},
  {"when": {"hostname": "(?i)ipad"}, "type": "iPad", "example": {"hostname": "iPad"}},
  {"when": {"hostname": "(?i)macbook|imac|mac-?mini|mac-?studio|mac-?pro"}, "type": "Mac", "example": {"hostname": "Someones-MacBook-Pro"}},
  {"when": {"hostname": "(?i)apple-?tv"}, "type": "Apple TV", "example": {"hostname": "Den-Apple-TV"}},
  {"when": {"hostname": "(?i)homepod"}, "type": "HomePod", "example": {"hostname": "HomePod"}},
  {"when": {"hostname": "(?i)watch"}, "type": "Watch", "example": {"hostname": "Apple-Watch"}},
  {"when": {"hostname": "(?i)^(ps[345]|playstation)"}, "type": "PlayStation", "example": {"hostname": "ps5-0a1b2c"}},
  {"when": {"hostname": "(?i)xbox"}, "type": "Xbox", "example": {"hostname": "XBOX"}},
  {"when": {"hostname": "(?i)nintendo|switch"}, "type": "Nintendo Switch", "example": {"hostname": "Nintendo-Switch"}},
  {"when": {"hostname": "(?i)galaxy|pixel|android|oneplus|moto"}, "type": "Android phone", "example": {"hostname": "Galaxy-S23"}},
  {"when": {"hostname": "(?i)desktop-|laptop-|^win"}, "type": "Windows PC", "example": {"hostname": "DESKTOP-AB12CD"}},
  {"when": {"hostname": "(?i)roku"}, "type": "Roku", "example": {"hostname": "Roku-Ultra"}},
  {"when": {"hostname": "(?i)fire-?tv|amazon-"}, "type": "Amazon device", "example": {"hostname": "Fire-TV-Stick"}},
  {"when": {"hostname": "(?i)echo"}, "type": "Echo speaker", "example": {"hostname": "Echo-Dot"}},
  {"when": {"hostname": "(?i)chromecast|google-?(home|nest|tv)"}, "type": "Google Cast device", "example": {"hostname": "Chromecast"}},
  {"when": {"hostname": "(?i)ecobee|thermostat|nest-?(learning|thermostat)"}, "type": "Thermostat", "example": {"hostname": "ecobee-thermostat"}},
  {"when": {"hostname": "(?i)printer|^hp[0-9a-f]{6}|^brw|^epson|^canon"}, "type": "Printer", "example": {"hostname": "HP0A1B2C"}},
  {"when": {"hostname": "(?i)^(cam|camera)|reolink|ring-|wyze|arlo"}, "type": "Camera", "example": {"hostname": "cam-garage"}},
  {"when": {"hostname": "(?i)tv$|-tv-|bravia|lgwebos|samsung"}, "type": "TV", "example": {"hostname": "Bedroom-TV"}},
  {"when": {"hostname": "(?i)raspberrypi|^rpi"}, "type": "Raspberry Pi", "example": {"hostname": "raspberrypi"}},
  {"when": {"hostname": "(?i)denon|marantz|onkyo|yamaha-?(rx|av)|avr"}, "type": "AV receiver", "example": {"hostname": "denon-avr-x1700h"}},
  {"when": {"hostname": "(?i)^(EP|HS|KP|KS|P1)\\d\\d|kasa|smart-?plug"}, "type": "Smart plug", "example": {"hostname": "HS105"}},
  {"when": {"hostname": "(?i)^GEModule|^GE[-_]"}, "type": "GE appliance", "example": {"hostname": "GEModule1234"}},
  {"when": {"hostname": "(?i)^schlage"}, "type": "Smart lock", "note": "Schlage Encode (Wi-Fi) uses its brand as its DHCP name", "example": {"hostname": "Schlage", "info": {"dhcp_params": "1,3,6"}}},
  {"when": {"hostname": "(?i)tuya|^wlan0$|^esp[-_]"}, "type": "Smart home device", "example": {"hostname": "esp_0a1b2c"}},
  {"when": {"mdns_model": "(?i)^(homebridge|scrypted)$"}, "tier": "role", "type": "Server", "note": "hosts HomeKit bridges", "example": {"info": {"mdns_services": ["_hap._tcp"], "mdns_models": ["md=homebridge"]}}},
  {"all": [{"mdns_service": "_hap._tcp"}, {"mdns_service": ["_smb._tcp", "_channels_dvr._tcp", "_plexmediasvr._tcp"]}], "tier": "role", "type": "Server", "note": "serves files or media next to HomeKit", "example": {"info": {"mdns_services": ["_hap._tcp", "_channels_dvr._tcp"]}}},
  {"when": {"mdns_service": "_googlecast._tcp"}, "type": "Google Cast device", "example": {"info": {"mdns_services": ["_googlecast._tcp"]}}, "tier": "strong_service"},
  {"when": {"mdns_service": "_sonos._tcp"}, "type": "Sonos speaker", "example": {"info": {"mdns_services": ["_sonos._tcp"]}}, "tier": "strong_service"},
  {"when": {"mdns_service": "_ipp._tcp"}, "type": "Printer", "example": {"info": {"mdns_services": ["_ipp._tcp"]}}, "tier": "strong_service"},
