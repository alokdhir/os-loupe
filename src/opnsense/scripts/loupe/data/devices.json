  {"when": {"mdns_service": "_printer._tcp"}, "type": "Printer", "example": {"info": {"mdns_services": ["_printer._tcp"]}}, "tier": "strong_service"},
  {"when": {"mdns_service": "_pdl-datastream._tcp"}, "type": "Printer", "example": {"info": {"mdns_services": ["_pdl-datastream._tcp"]}}, "tier": "strong_service"},
  {"when": {"mdns_service": "_hap._tcp"}, "type": "HomeKit accessory", "example": {"info": {"mdns_services": ["_hap._tcp"]}}},
  {"when": {"mdns_service": "_hap._udp"}, "type": "HomeKit accessory", "example": {"info": {"mdns_services": ["_hap._udp"]}}},
  {"when": {"mdns_service": "_matter._tcp"}, "type": "Matter device", "example": {"info": {"mdns_services": ["_matter._tcp"]}}},
