  {"when": {"mdns_service": "_channels_dvr._tcp"}, "type": "Media server", "example": {"info": {"mdns_services": ["_channels_dvr._tcp"]}}},
  {"when": {"mdns_service": "_plexmediasvr._tcp"}, "type": "Media server", "example": {"info": {"mdns_services": ["_plexmediasvr._tcp"]}}},
  {"when": {"mdns_service": "_spotify-connect._tcp"}, "type": "Speaker / streamer", "example": {"info": {"mdns_services": ["_spotify-connect._tcp"]}}},
  {"when": {"mdns_service": "_smb._tcp"}, "type": "Computer", "example": {"info": {"mdns_services": ["_smb._tcp"]}}},
  {"when": {"mdns_service": "_ssh._tcp"}, "type": "Computer", "example": {"info": {"mdns_services": ["_ssh._tcp"]}}},
  {"when": {"dhcp_vendor": "^MSFT"}, "type": "Windows PC", "example": {"info": {"dhcp_vendor_class": "MSFT-1.0"}}},
