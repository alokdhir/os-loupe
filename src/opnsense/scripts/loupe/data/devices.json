{
 "_comment": [
  "Device identification rules for Loupe. See README 'Device rules'.",
  "One entry per type: a device is that type when any of its alternatives ('any') matches. An alternative matches when every condition in 'when' (or every entry of 'all') matches; a list value means any of.",
  "Fields: mac_prefix, mdns_model (regex), mdns_name (Bonjour instance name, regex), hostname (regex), mdns_service (exact),",
  "category (HomeKit category hap:N or Matter device type matter:0xNNNN, exact), dhcp_vendor (regex),",
  "dhcp_params (prefix of the request list), talks_to (domain suffix), vendor (whole word), private_mac (bool).",
  "Category codes: HomeKit accessory categories (HAP spec; as in HAP-NodeJS Categories) and Matter device types",
  "(connectedhomeip data_model/1.7/device_types/device_type_ids.json); generic ones (bridge, root node, other) have no rule.",
  "Tiers run in a fixed order (strongest evidence first, see TIERS in lib/devid.py); an alternative's tier defaults to its first field.",
  "A type marked generic names a platform or a maker, not what the device is: the AI Rule Generator offers those devices.",
  "each alternative's 'example' is synthetic evidence that must classify as the entry's type (checked by the tests).",
  "Distro rules (Ubuntu, Debian...) match the update servers a machine checks; containers can blur them.",
  "Shipped talks_to rules skip private MACs and computer_vendors: a phone or laptop opening a vendor's website is not",
  "that vendor's device (devices themselves don't randomize their MAC and aren't built on these makers' network chips)."
 ],
 "rules": [
  {"type": "Virtual machine", "vendor": "QEMU/KVM", "any": [
   {"when": {"mac_prefix": "52:54:00"}, "example": {"mac": "52:54:00:00:00:01"}}
  ]},
  {"type": "Tesla", "any": [
   {"when": {"vendor": "Tesla"}, "tier": "mac_prefix", "note": "Tesla's own MAC block, only on Tesla hardware; the car's DHCP client says MSFT 5.0", "example": {"vendor": "Tesla,Inc.", "info": {"dhcp_vendor_class": "MSFT 5.0"}}},
   {"when": {"talks_to": ["tesla.services", "tesla.com"]}, "example": {"names": ["x.tesla.services"]}}
  ]},
  {"type": "Miele appliance", "any": [
   {"when": {"vendor": "Miele"}, "tier": "mac_prefix", "note": "Miele's own MAC block, on the Wi-Fi modules (XKM) in its ovens, washers, dishwashers and coffee machines", "example": {"vendor": "Miele & Cie. KG"}}
  ]},
  {"type": "Apple TV", "any": [
   {"when": {"mdns_model": "^AppleTV"}, "example": {"info": {"mdns_models": ["model=AppleTV14,1"]}}},
   {"when": {"hostname": "(?i)apple-?tv"}, "example": {"hostname": "Den-Apple-TV"}},
   {"when": {"category": "hap:24"}, "example": {"info": {"mdns_categories": ["hap:24"]}}}
  ]},
  {"type": "HomePod", "any": [
   {"when": {"mdns_model": "^AudioAccessory"}, "example": {"info": {"mdns_models": ["model=AudioAccessory5,1"]}}},
   {"when": {"hostname": "(?i)homepod"}, "example": {"hostname": "HomePod"}},
   {"when": {"category": "hap:25"}, "example": {"info": {"mdns_categories": ["hap:25"]}}}
  ]},
  {"type": "Mac", "any": [
   {"when": {"mdns_model": "^(MacBook|Macmini|MacPro|iMac|Mac\\d|MacStudio)"}, "example": {"info": {"mdns_models": ["model=Mac14,14"]}}},
   {"when": {"hostname": "(?i)macbook|imac|mac-?mini|mac-?studio|mac-?pro"}, "example": {"hostname": "Someones-MacBook-Pro"}}
  ]},
  {"type": "iPhone", "any": [
   {"when": {"mdns_model": "^iPhone"}, "example": {"info": {"mdns_models": ["model=iPhone15,2"]}}},
   {"when": {"hostname": "(?i)iphone"}, "example": {"hostname": "Kids-iPhone"}}
  ]},
  {"type": "iPad", "any": [
   {"when": {"mdns_model": "^iPad"}, "example": {"info": {"mdns_models": ["model=iPad13,1"]}}},
   {"when": {"hostname": "(?i)ipad"}, "example": {"hostname": "iPad"}}
  ]},
  {"type": "Apple Watch", "any": [
   {"when": {"mdns_model": "^Watch"}, "example": {"info": {"mdns_models": ["model=Watch6,1"]}}}
  ]},
  {"type": "Google Cast device", "any": [
   {"when": {"mdns_model": "Chromecast|Google TV|Google Nest|Nest (Hub|Mini|Audio)|Google Home"}, "example": {"info": {"mdns_models": ["model=Chromecast Ultra"]}}},
   {"when": {"hostname": "(?i)chromecast|google-?(home|nest|tv)"}, "example": {"hostname": "Chromecast"}},
   {"when": {"mdns_service": "_googlecast._tcp"}, "example": {"info": {"mdns_services": ["_googlecast._tcp"]}}, "tier": "strong_service"}
  ]},
  {"type": "Sonos speaker", "any": [
   {"when": {"mdns_model": "(?i)sonos"}, "example": {"info": {"mdns_models": ["model=Sonos One"]}}},
   {"when": {"mdns_service": "_sonos._tcp"}, "example": {"info": {"mdns_services": ["_sonos._tcp"]}}, "tier": "strong_service"},
   {"when": {"talks_to": "sonos.com"}, "example": {"names": ["x.sonos.com"]}},
   {"when": {"vendor": "Sonos"}, "example": {"vendor": "Sonos Corp."}}
  ]},
  {"type": "Roku", "any": [
   {"when": {"mdns_model": "(?i)roku"}, "example": {"info": {"mdns_models": ["model=Roku Ultra"]}}},
   {"when": {"hostname": "(?i)roku"}, "example": {"hostname": "Roku-Ultra"}},
   {"when": {"talks_to": "roku.com"}, "example": {"names": ["x.roku.com"]}},
   {"when": {"vendor": "Roku"}, "example": {"vendor": "Roku Corp."}}
  ]},
  {"type": "Printer", "any": [
   {"when": {"mdns_model": "(?i)^(usb_mdl|ty)=|laserjet|officejet|deskjet|envy|pixma|ecotank|brother|epson"}, "example": {"info": {"mdns_models": ["model=HP Color LaserJet MFP M476dw"]}}},
   {"when": {"hostname": "(?i)printer|^hp[0-9a-f]{6}|^brw|^epson|^canon"}, "example": {"hostname": "HP0A1B2C"}},
   {"when": {"mdns_service": ["_ipp._tcp", "_ipps._tcp", "_printer._tcp", "_pdl-datastream._tcp"]}, "example": {"info": {"mdns_services": ["_ipp._tcp"]}}, "tier": "strong_service"},
   {"when": {"dhcp_vendor": "^Mfg="}, "example": {"info": {"dhcp_vendor_class": "Mfg=Hewlett"}}},
   {"when": {"vendor": "HP Inc"}, "example": {"vendor": "HP Inc Corp."}}
  ]},
  {"type": "NanoKVM", "any": [
   {"when": {"hostname": "(?i)^kvm-[0-9a-f]{4}$"}, "example": {"hostname": "kvm-0a1b"}}
  ]},
  {"type": "PiKVM", "any": [
   {"when": {"hostname": "(?i)^pikvm\\b"}, "example": {"hostname": "pikvm"}}
  ]},
  {"type": "Watch", "any": [
   {"when": {"hostname": "(?i)(^|-)watch$"}, "example": {"hostname": "Apple-Watch"}}
  ]},
  {"type": "PlayStation", "any": [
   {"when": {"hostname": "(?i)^(ps[345]|playstation)"}, "example": {"hostname": "ps5-0a1b2c"}},
   {"when": {"talks_to": ["playstation.net", "playstation.com", "sonyentertainmentnetwork.com"]}, "example": {"names": ["x.playstation.net"]}},
   {"when": {"vendor": "Sony Interactive"}, "example": {"vendor": "Sony Interactive Corp."}}
  ]},
  {"type": "Xbox", "any": [
   {"when": {"hostname": "(?i)xbox"}, "example": {"hostname": "XBOX"}},
   {"when": {"talks_to": ["xboxlive.com", "xbox.com"]}, "example": {"names": ["x.xboxlive.com"]}}
  ]},
  {"type": "Nintendo Switch", "any": [
   {"when": {"hostname": "(?i)nintendo"}, "example": {"hostname": "Nintendo-Switch"}},
   {"when": {"talks_to": ["nintendo.net", "nintendo.com"]}, "example": {"names": ["x.nintendo.net"]}},
   {"when": {"vendor": "Nintendo"}, "example": {"vendor": "Nintendo Corp."}}
  ]},
  {"type": "Fire TV", "any": [
   {"all": [{"vendor": "Amazon Technologies"}, {"hostname": "(?i)^android-"}], "tier": "hostname", "note": "Fire OS sends android-N as its DHCP name", "example": {"vendor": "Amazon Technologies Inc.", "hostname": "android-2"}}
  ]},
  {"type": "Android phone", "any": [
   {"when": {"hostname": "(?i)^(galaxy|pixel|oneplus|moto)|^android[-_]"}, "example": {"hostname": "Galaxy-S23"}}
  ]},
  {"type": "Windows PC", "any": [
   {"when": {"hostname": "(?i)^desktop-|^laptop-|^win-"}, "example": {"hostname": "DESKTOP-AB12CD"}},
   {"when": {"dhcp_vendor": "^MSFT"}, "example": {"info": {"dhcp_vendor_class": "MSFT-1.0"}}}
  ]},
  {"type": "Amazon device", "any": [
   {"when": {"hostname": "(?i)fire-?tv|amazon-"}, "example": {"hostname": "Fire-TV-Stick"}},
   {"when": {"vendor": "Amazon Technologies"}, "example": {"vendor": "Amazon Technologies Corp."}}
  ]},
  {"type": "Echo speaker", "any": [
   {"when": {"hostname": "(?i)^echo([-_ ]|$)"}, "example": {"hostname": "Echo-Dot"}},
   {"when": {"talks_to": ["amazon-dss.com", "alexa.amazon.com"]}, "example": {"names": ["x.amazon-dss.com"]}}
  ]},
  {"type": "TV", "any": [
   {"when": {"mdns_model": "(?i)bravia|smart ?tv|^(LG|Samsung|Vizio|TCL|Hisense)"}, "example": {"info": {"mdns_models": ["model=BRAVIA 4K VH22"]}}},
   {"when": {"hostname": "(?i)tv$|-tv-|bravia|lgwebos"}, "example": {"hostname": "Bedroom-TV"}},
   {"when": {"category": ["hap:31", "matter:0x0028"]}, "example": {"info": {"mdns_categories": ["hap:31"]}}}
  ]},
  {"type": "Thermostat", "any": [
   {"when": {"hostname": "(?i)ecobee|thermostat|nest-?(learning|thermostat)"}, "example": {"hostname": "ecobee-thermostat"}},
   {"when": {"category": ["hap:9", "matter:0x0301"]}, "example": {"info": {"mdns_categories": ["hap:9"]}}},
   {"when": {"talks_to": "ecobee.com"}, "example": {"names": ["x.ecobee.com"]}},
   {"when": {"vendor": "ecobee"}, "example": {"vendor": "ecobee Corp."}}
  ]},
  {"type": "NVR", "any": [
   {"when": {"hostname": "(?i)^nvr"}, "note": "Reolink NVRs call themselves NVR; nothing else sets them apart from their cameras", "example": {"hostname": "NVR"}}
  ]},
  {"type": "Camera", "any": [
   {"when": {"hostname": "(?i)^(cam|camera)|reolink|^ring-|wyze|^arlo"}, "example": {"hostname": "cam-garage"}},
   {"when": {"category": ["hap:17", "matter:0x0142", "matter:0x0144", "matter:0x0145"]}, "example": {"info": {"mdns_categories": ["hap:17"]}}},
   {"when": {"talks_to": ["wyzecam.com", "reolink.com"]}, "example": {"names": ["x.wyzecam.com"]}},
   {"when": {"vendor": ["Reolink", "Wyze"]}, "example": {"vendor": "Reolink Corp."}}
  ]},
  {"type": "Raspberry Pi", "any": [
   {"when": {"hostname": "(?i)raspberrypi|^rpi"}, "example": {"hostname": "raspberrypi"}},
   {"when": {"talks_to": ["archive.raspberrypi.com", "archive.raspberrypi.org"]}, "example": {"names": ["archive.raspberrypi.com"]}},
   {"when": {"vendor": "Raspberry Pi"}, "example": {"vendor": "Raspberry Pi Corp."}}
  ]},
  {"type": "AV receiver", "any": [
   {"when": {"hostname": "(?i)denon|marantz|onkyo|yamaha-?(rx|av)|^avr|-avr"}, "example": {"hostname": "denon-avr-x1700h"}},
   {"when": {"category": "hap:34"}, "example": {"info": {"mdns_categories": ["hap:34"]}}},
   {"when": {"vendor": "D&M Holdings"}, "example": {"vendor": "D&M Holdings Corp."}}
  ]},
  {"type": "Smart plug", "any": [
   {"when": {"hostname": "(?i)^(EP|HS|KP|KS|P1)\\d\\d|kasa|smart-?plug"}, "example": {"hostname": "HS105"}},
   {"when": {"category": ["hap:7", "matter:0x010a", "matter:0x010b"]}, "example": {"info": {"mdns_categories": ["hap:7"]}}}
  ]},
  {"type": "Appliance (GE / Haier module)", "any": [
   {"when": {"hostname": "(?i)^GEModule|^GE[-_]"}, "example": {"hostname": "GEModule1234"}, "note": "GE Appliances' Wi-Fi module, also used in Fisher & Paykel and other Haier brands"},
   {"when": {"vendor": "General Electric"}, "example": {"vendor": "General Electric Corp."}}
  ]},
  {"type": "Smart lock", "any": [
   {"when": {"hostname": "(?i)^schlage"}, "note": "Schlage Encode (Wi-Fi) uses its brand as its DHCP name", "example": {"hostname": "Schlage", "info": {"dhcp_params": "1,3,6"}}},
   {"when": {"category": ["hap:6", "matter:0x000a"]}, "example": {"info": {"mdns_categories": ["hap:6"]}}}
  ]},
  {"type": "TV tuner", "any": [
   {"when": {"hostname": "(?i)^HDHR-[0-9a-f]{8}$"}, "note": "SiliconDust HDHomeRun: HDHR- plus its device ID", "example": {"hostname": "HDHR-1A2B3C4D"}}
  ]},
  {"type": "Smart home device", "any": [
   {"when": {"hostname": "(?i)tuya|^wlan0$|^esp[-_]"}, "example": {"hostname": "esp_0a1b2c"}},
   {"when": {"talks_to": ["tuyaus.com", "tuya.com"]}, "example": {"names": ["x.tuyaus.com"]}},
   {"when": {"vendor": "Tuya"}, "example": {"vendor": "Tuya Corp."}}
  ]},
  {"type": "Server", "any": [
   {"when": {"mdns_model": "(?i)^(homebridge|scrypted)$"}, "tier": "role", "note": "hosts HomeKit bridges", "example": {"info": {"mdns_services": ["_hap._tcp"], "mdns_models": ["md=homebridge"]}}},
   {"all": [{"mdns_service": "_hap._tcp"}, {"mdns_service": ["_smb._tcp", "_channels_dvr._tcp", "_plexmediasvr._tcp"]}], "tier": "role", "note": "serves files or media next to HomeKit", "example": {"info": {"mdns_services": ["_hap._tcp", "_channels_dvr._tcp"]}}}
  ]},
  {"type": "Window shade", "any": [
   {"when": {"category": ["hap:14", "matter:0x0202"]}, "example": {"info": {"mdns_categories": ["hap:14"]}}}
  ]},
  {"type": "Speaker / streamer", "any": [
   {"when": {"category": ["hap:26", "matter:0x0020", "matter:0x0021", "matter:0x0022"]}, "example": {"info": {"mdns_categories": ["hap:26"]}}},
   {"when": {"mdns_service": "_spotify-connect._tcp"}, "example": {"info": {"mdns_services": ["_spotify-connect._tcp"]}}}
  ]},
  {"type": "Wi-Fi access point", "any": [
